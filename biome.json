{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!.next",
      "!node_modules",
      "!next-env.d.ts",
      "!public",
      "!.agents",
      "!.weaverse"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "next/link": "Use the locale-aware `Link` from `@/components/link`.",
              "@weaverse/schema": "Import from `@weaverse/next`: it re-exports `@weaverse/schema`, which is not a dependency of this theme.",
              "@weaverse/react": "Import from `@weaverse/next`: `@weaverse/react` is not a dependency of this theme.",
              "@weaverse/core": "Import from `@weaverse/next`: `@weaverse/core` is not a dependency of this theme.",
              "@weaverse/next": {
                "importNames": ["useTranslation"],
                "message": "Use `useT` or `<T>` from `@/lib/i18n/t`: they resolve through the theme's own-property-safe translator."
              },
              "next/navigation": {
                "importNames": ["usePathname"],
                "message": "Use `usePathname` from `@/lib/i18n/locale-context`: Next reports the internal `/en-us` rewrite while rendering on the server."
              }
            }
          }
        }
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["tests/dom/preload.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    },
    {
      "includes": ["tests/browser/**"],
      "linter": {
        "rules": {
          "performance": {
            "useDomNodeTextContent": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/components/link.tsx",
        "src/lib/i18n/locale-context.tsx",
        "src/lib/i18n/t.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
