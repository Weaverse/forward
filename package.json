{
  "name": "forward",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "description": "Forward — a fresh Next.js App Router storefront theme for Shopify, powered by Weaverse.",
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "scripts": {
    "dev": "next dev --port 3333",
    "clean:next": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\"",
    "build": "bun run clean:next && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test:node": "vp test --project node",
    "test:dom": "vp test --project dom",
    "test": "vp test",
    "test:browser:live-account-disabled": "bun scripts/browser-matrix.mts live-account-disabled",
    "test:browser:live-account-enabled": "bun scripts/browser-matrix.mts live-account-enabled",
    "test:browser": "bun run test:browser:live-account-disabled && bun run test:browser:live-account-enabled",
    "check:graphql": "hydrogen gql check",
    "check:theme": "node scripts/check-tailwind-theme.mts",
    "check:routes": "node scripts/check-routes.mts",
    "smoke:routes": "node scripts/smoke-routes.mts",
    "seed:weaverse": "bun scripts/seed-weaverse.mts",
    "verify:shopify": "bun scripts/verify-shopify.mts",
    "verify:live": "bun scripts/verify-matrix.mts live",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run check:graphql && bun run build && bun run check:theme && bun run check:routes"
  },
  "dependencies": {
    "@shopify/hydrogen": "2026.10.3",
    "@weaverse/hydrogen": "6.1.3",
    "class-variance-authority": "0.7.1",
    "next": "16.4.6",
    "parse5": "8.1.1",
    "react": "19.3.1",
    "react-country-flag": "3.1.0",
    "react-dom": "19.3.1",
    "react-svg-credit-card-payment-icons": "6.0.4"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0"
  }
}
